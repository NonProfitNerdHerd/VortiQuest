---
import Layout from '../../layouts/Layout.astro';
import ProductIntro from '../../components/ProductIntro.astro';
import CTA from '../../components/CTA.astro';
import { products } from '../../data/site';
import HeroBand from '../../components/HeroBand.astro';
import { Image } from 'astro:assets';
import whiteboard from '../../assets/whiteboard.jpg';
---
<Layout title="Our products" description="Explore the problems behind VortiPress, VortiCause, VortiTask, and VortiQuest: the ideas behind them, who they fit, and where to learn more.">
<HeroBand variant="products"><span class="eyebrow">THE VORTIQUEST COLLECTION</span><h1>Real problems.<br/><em>A reason to build.</em></h1><p class="lead">Each of our products starts with something that could work better. Here’s the problem, the thinking behind the solution, and a closer look at where it could fit. No treasure map required.</p><nav class="collection-nav" aria-label="Explore our products">{products.map(p => <a href={'#'+p.slug}>{p.name}<span aria-hidden="true">↓</span></a>)}</nav><Image slot="image" src={whiteboard} widths={[480, 800, 1200, 1600, 2000]} sizes="(max-width: 800px) 100vw, 45vw" alt="Two people discussing ideas arranged on a whiteboard with colorful sticky notes." loading="eager" fetchpriority="high" format="webp" quality={82}/><span slot="credit">Illustrative photography · Walls.io / Pexels</span></HeroBand>
<div class="container product-cases">{products.map(p => <ProductIntro product={p}/>)}</div>
<section class="container note-band"><h2>The right fit<br/><em>comes first.</em></h2><p>Our products are options to evaluate alongside other solutions. These projects are in development. Explore their business cases or talk with us about your needs and alternatives. We’ll help you understand the responsibilities and tradeoffs before you commit.</p></section><CTA/>
</Layout>
