---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getArticles, formatDate } from '../../blog/articles';
import ArticleTopics from '../../components/ArticleTopics.astro';
export async function getStaticPaths() { return (await getArticles()).map(article => ({ params: { slug: article.id }, props: { article } })); }
const { article } = Astro.props;
const { Content } = await render(article);
const { data } = article;
const draft = data.status === 'draft';
---
<Layout title={data.title} description={data.description} noindex={draft} article={{ author: data.author, publishedAt: data.publishedAt, updatedAt: data.updatedAt }} socialImage={data.cover ? { src: data.cover.src.src, alt: data.cover.alt, width: data.cover.src.width, height: data.cover.src.height } : undefined}>
  <article class="blog-article">
    <header class="article-header container"><a class="back-link" href="/blog/">← All articles</a>{draft && <span class="draft-label article-draft">Draft · Local preview</span>}<ArticleTopics ids={data.topics}/><h1>{data.title}</h1><p class="article-description">{data.description}</p><div class="article-byline"><span>By {data.author}</span>{data.publishedAt && <span>Published <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time></span>}{data.updatedAt && <span>Updated <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time></span>}</div></header>
    {data.cover && <figure class="article-cover container"><Image src={data.cover.src} widths={[480, 800, 1200, 1600]} sizes="(max-width: 800px) 100vw, 1000px" alt={data.cover.alt} loading="eager" fetchpriority="high" format="webp"/><figcaption>{data.cover.credit}</figcaption></figure>}
    <div class="article-body container"><Content/></div>
    <footer class="article-end container"><p>Questions about how this fits your organization?</p><a class="text-link" href="/contact/">Tell us what’s getting in the way <span aria-hidden="true">↗</span></a><a class="text-link" href="/blog/">Back to all articles <span aria-hidden="true">↗</span></a></footer>
  </article>
</Layout>
