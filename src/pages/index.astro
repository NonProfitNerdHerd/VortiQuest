---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CTA from '../components/CTA.astro';
import AdvisoryPromise from '../components/AdvisoryPromise.astro';
import { Image } from 'astro:assets';
import HeroBand from '../components/HeroBand.astro';
import workspace from '../assets/workspace.jpg';
import SupportStory from '../components/SupportStory.astro';
import EverydayStory from '../components/EverydayStory.astro';
import ServiceDiagram from '../components/ServiceDiagram.astro';
import { products, services } from '../data/site';
---
<Layout>
<HeroBand variant="home"><div class="eyebrow"><span class="status-dot"></span> YOUR PERSONAL TECHNOLOGY PARTNER</div><h1>The right technology.<br/>Built around<br/><em>your business.</em></h1><p>We listen to what matters to your organization, help you weigh the options, and put the right solution into practice—with your long-term interests at heart.</p><div class="hero-actions"><a href="/contact/" class="button">Let’s talk about your needs <span aria-hidden="true">↗</span></a><a href="/products/" class="text-link">Explore our products <span aria-hidden="true">↗</span></a></div><span class="hero-note">Thoughtful advice. Practical solutions. Ongoing support.</span>
<Image slot="image" src={workspace} widths={[480, 800, 1200, 1600, 1800]} sizes="(max-width: 800px) 100vw, 45vw" alt="A bright workspace with a laptop on a white desk beside a large window." loading="eager" fetchpriority="high" format="webp" quality={85}/>
<span slot="credit">Illustrative workspace · Darina Belonogova / Pexels</span>
</HeroBand>
<AdvisoryPromise/>
<EverydayStory/>
<section class="clarity-band section"><div class="container"><div class="section-heading"><div><span class="eyebrow">HOW WE HELP</span><h2>A little clarity.<br/>A lot of <em>possibility.</em></h2></div><p>You don’t need every new tool.  You need the right partner to figure out  what actually works for you.</p></div><div class="services-grid">{services.map((s, i) => <article class="service"><h3>{s.short}</h3><p>{s.text}</p><a class="text-link" href={`/services/#${['guidance', 'development', 'hosting'][i]}`}>Explore {s.short.toLowerCase()} <span aria-hidden="true">↗</span></a></article>)}</div></div></section>
<SupportStory/>
<section class="products-section section"><div class="container"><div class="section-heading"><div><span class="eyebrow">BUILT BY VORTIQUEST</span><h2>Our ideas,<br/><em>out in the world.</em></h2></div><div><p>Software we build and share.  We’ll help you evaluate the fit—including  when another platform would serve you better.</p><a class="text-link" href="/products/">Meet our products ↗</a></div></div><div class="products-grid">{products.map(p => <ProductCard product={p}/>)}</div><p class="section-footnote">Built to be shared. Supported when you need it. Repository terms apply to each implementation.</p></div></section>
<section class="section container process"><div><span class="eyebrow">THE WAY WE WORK</span><h2>First, we listen.<br/>Then, we <em>recommend.</em></h2><p>We start with the problem you need to solve, then consider the people, security, ethical requirements, and ongoing responsibilities behind each option.</p><a href="/services/" class="text-link">Get to know our approach ↗</a></div><ol class="process-list">{[['Understand', 'Your people, your goals, and the friction in between.'], ['Evaluate', 'Keep what works. Compare buying, connecting, and building.'], ['Implement', 'Put the right solution into practice, with you involved.'], ['Support', 'Keep it useful, maintained, and moving with your business.']].map(([title, text]) => <li><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>
<section class="container partnership-section"><div><span class="eyebrow">A TEAM IN YOUR CORNER</span><h2>Here for the decision.<br/><em>And what follows.</em></h2></div><div><p>We bring business understanding and technical delivery together. From choosing a platform to hosting, support, and the next improvement, our role is to help you solve the right problem for the long term.</p><a href="/about/" class="text-link">Our principles & the people behind them ↗</a></div></section>
<div class="container"><ServiceDiagram/></div>
<CTA/>
</Layout>
