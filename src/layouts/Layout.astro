---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean; article?: { author: string; publishedAt?: Date; updatedAt?: Date }; socialImage?: { src: string; alt: string; width: number; height: number } }
const { title, description = site.description, noindex = false, article, socialImage } = Astro.props;
const fullTitle = title ? `${title} — VortiQuest` : 'VortiQuest — Technology with a personal side.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [['Services', '/services/'], ['Products', '/products/'], ['Blog', '/blog/'], ['About', '/about/']];
---
<!doctype html><html lang="en"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{fullTitle}</title><meta name="description" content={description}/><meta name="theme-color" content="#F7F9FC"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="canonical" href={canonical}/>
{(noindex || !site.domainConfirmed) && <meta name="robots" content="noindex, nofollow"/>}
<meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(socialImage?.src || '/social.png', Astro.site)}/><meta property="og:image:width" content={String(socialImage?.width || 1200)}/><meta property="og:image:height" content={String(socialImage?.height || 630)}/><meta property="og:image:alt" content={socialImage?.alt || 'VortiQuest. The right technology. Built around your business.'}/><meta name="twitter:card" content="summary_large_image"/>
{article && <><meta name="author" content={article.author}/>{article.publishedAt && <meta property="article:published_time" content={article.publishedAt.toISOString()}/>}{article.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()}/>}</>}
</head><body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="header-reserve" aria-hidden="true"></div><div class="header-shell"><header class="site-header container"><a href="/" aria-label="VortiQuest home"><Brand/></a><nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label, href]) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}<a class="nav-contact" href="/contact/" aria-current={Astro.url.pathname === '/contact/' ? 'page' : undefined}>Let’s talk <span aria-hidden="true">↗</span></a></nav>
<details class="mobile-nav"><summary>Menu <span aria-hidden="true">＋</span></summary><nav aria-label="Mobile navigation">{nav.map(([label, href]) => <a href={href}>{label}</a>)}<a href="/contact/">Contact ↗</a></nav></details></header></div>
<main id="main" tabindex="-1"><slot/></main>
<footer class="site-footer container"><div class="footer-top"><a href="/" aria-label="VortiQuest home"><Brand/></a><p>Thoughtful technology. A human on the other end.</p><a href={`mailto:${site.email}`} class="text-link">{site.email} ↗</a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} VortiQuest</span><span class="footer-links">{site.github ? <a href={site.github}>GitHub ↗</a> : <span class="pending-link">GitHub · Add Link</span>}<a href={site.linkedIn}>LinkedIn ↗</a><a href="/privacy/">Privacy</a></span><span>Built with purpose.</span></div></footer>
<script>
const root = document.documentElement;
let compact = false;
let scheduled = false;
const updateHeader = () => {
  if (window.scrollY > 64) compact = true;
  else if (window.scrollY < 16) compact = false;
  root.classList.toggle('header-compact', compact);
  scheduled = false;
};
updateHeader();
window.addEventListener('pageshow', updateHeader);
window.addEventListener('scroll', () => {
  if (!scheduled) { scheduled = true; requestAnimationFrame(updateHeader); }
}, { passive: true });
const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
const menuToggle = mobileMenu?.querySelector<HTMLElement>('summary');
document.addEventListener('keydown', (event) => {
  if (event.key === 'Escape' && mobileMenu?.open) {
    mobileMenu.open = false;
    menuToggle?.focus();
  }
});
mobileMenu?.querySelectorAll('nav a').forEach(link => link.addEventListener('click', () => { mobileMenu.open = false; }));
</script>
</body></html>
