---
import ProductVisual from './ProductVisual.astro';
import type { Product } from '../data/site';
interface Props { product: Product; detail?: boolean }
const { product: p, detail = false } = Astro.props;
---
<section class:list={['product-case', { 'case-detail': detail }]} id={detail ? 'business-case' : p.slug} aria-label={`${p.name} business case`}>
  {!detail && p.slug === 'vortipress' && <span id="vortiblog" class="legacy-product-anchor" aria-hidden="true"></span>}
  <div class="case-introduction"><span class="eyebrow">{p.category}</span>{detail ? <h2>{p.summary}</h2> : <h2><a href={`/products/${p.slug}/`}>{p.name}<span class="serif-period">.</span></a></h2>}{!detail && <p class="case-tagline">{p.summary}</p>}{p.description.split('\n\n').map(paragraph => <p class="case-description">{paragraph}</p>)}</div>
  <div class="case-main"><ProductVisual product={p} priority={detail}/><div class="case-story"><div><h3>The problem</h3>{p.problem.split('\n\n').map(paragraph => <p>{paragraph}</p>)}</div><div><h3>{p.rationaleTitle}</h3>{p.rationale.split('\n\n').map(paragraph => <p>{paragraph}</p>)}</div><p class="case-personality">{p.personality}</p></div></div>
  <div class="case-bottom"><div class="case-capabilities"><h3>What it helps you do</h3>{p.verified ? <ul>{p.capabilities.map(item => <li>{item}</li>)}</ul> : <div class="case-preparing"><span class="eyebrow">PRODUCT DETAILS BEING PREPARED</span><p>Product details are being prepared. We’ll share more about {p.name}’s workflows and capabilities as its public introduction develops.</p></div>}{p.platformNote && <p class="case-platform">{p.platformNote}</p>}</div><div class="case-fit"><h3>Who it fits</h3><p>{p.audience}</p><div class="case-actions">{!detail && <a class="text-link" href={`/products/${p.slug}/`}>Read the business case ↗</a>}<a class="text-link" href={`/contact/?product=${encodeURIComponent(p.name)}`}>Discuss the fit ↗</a></div><p class="product-status">In development · Not yet available for release.</p></div></div>
</section>
